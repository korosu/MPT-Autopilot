# secrets and user-specific configuration
.env
config.yaml
accounts.yaml

# your actual jobs (topics are private) — copy from jobs.example.yaml
jobs.yaml
jobs_*.yaml
!jobs.example.yaml

# dedup registries — generated at runtime, contain personal video history
seen.txt
seen_*.txt
seen.db
*.in_progress.txt

# stale lock markers left behind by an interrupted run (see src/mpt_autopilot/lock.py).
# Narrower than *.lock on purpose: uv.lock must stay tracked.
*.txt.lock
*.yaml.lock
# the batch stage locks <seen_file>.stem + ".lock" (see batch/run.py), which is
# "seen.lock" / "seen_en.lock" — not covered by the two patterns above.
seen*.lock

# generated output
exports/
exports_*/
logs/
meta/

# uploader ledger. WAL mode also creates -wal and -shm sidecars while it runs.
*.sqlite
*.sqlite-wal
*.sqlite-shm

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
Python/

# tooling caches
.uv-cache/
.ruff_cache/
.pytest_cache/
# pytest drops these into cwd when basetemp can't be created
pytest-cache-files-*/
# agent scratch dirs
.tmptest*/
tmptest/
.tmp-py
.pytest-sandbox-work
.pytest-sandbox
.pytest-tmp

# editors / OS
.idea/
.DS_Store

# generated video files (can be large)
*.mp4
*.log

# AI-agent instructions (local, user-specific)
CLAUDE.md
AGENTS.md
skills
