# =============================================================================
# MPT Autopilot — .env.example
#
#     cp .env.example .env
#
# .env is gitignored and must never be committed. It holds every secret; all
# non-secret settings live in config.yaml.
#
# `mpt` looks for .env NEXT TO config.yaml first, then in the current
# directory — so `mpt --config /srv/mpt/config.yaml run` picks up
# /srv/mpt/.env automatically.
# =============================================================================

# ── LLM (used by `mpt refill` and `mpt enrich`) ───────────────────────────────
#
# Both stages share one provider. `mpt refill` requires these three to be set;
# `mpt enrich` needs LLM_API_KEY.

# Your API key.
#   Anthropic: https://console.anthropic.com/
#   OpenAI:    https://platform.openai.com/
#   Groq:      https://console.groq.com/
LLM_API_KEY=sk-...

# API base URL — this is what selects the provider:
#   Anthropic: https://api.anthropic.com        (auto-detected from the URL)
#   OpenAI:    https://api.openai.com/v1
#   Groq:      https://api.groq.com/openai/v1
#   Together:  https://api.together.xyz/v1
#   Ollama:    http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# Model name — must be one your provider accepts.
LLM_MODEL=gpt-4o-mini

# Read timeout in seconds for the enricher's LLM calls (default 60).
LLM_TIMEOUT=120

# ── Telegram alerts (optional, shared by every stage) ─────────────────────────
#
# Leave BOTH empty to disable notifications entirely. Create a bot via
# @BotFather, message it once, then read your chat_id from
# https://api.telegram.org/bot<token>/getUpdates
#
# The prefix shown in each alert is config.yaml's telegram_prefix, not an env var.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
